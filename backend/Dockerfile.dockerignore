# Allowlist: everything is excluded, then exactly what the build needs is let back in.
# A denylist leaks whatever nobody thought to list — a .env, node_modules, a build dir.
*
!gradlew
!gradle/
!settings.gradle.kts
!build.gradle.kts
!backend/build.gradle.kts
!backend/src/main/
# The SPA (Phase 7). Named files: not node_modules, not dist, not e2e.
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
